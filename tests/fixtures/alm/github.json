{
  "provider": "github",
  "config": {
    "alm_version": 1,
    "provider": "github",
    "base_url": "https://ghe.acme.example/api/v3/",
    "repo": "acme/widgets",
    "token_env": "SPECGATE_CONFORMANCE_TOKEN"
  },
  "env": {
    "SPECGATE_CONFORMANCE_TOKEN": "tok"
  },
  "routes": [
    {
      "match": "/repos/acme/widgets/issues",
      "method": "POST",
      "json": {
        "number": 42,
        "html_url": "https://ghe.acme.example/acme/widgets/issues/42",
        "state": "open"
      }
    },
    {
      "match": "/repos/acme/widgets/issues/7",
      "method": "GET",
      "json": { "number": 7, "state": "open", "state_reason": null }
    },
    {
      "match": "/repos/acme/widgets/issues/8",
      "method": "GET",
      "json": { "number": 8, "state": "closed", "state_reason": "completed" }
    },
    {
      "match": "/repos/acme/widgets/issues/9",
      "method": "GET",
      "json": { "number": 9, "state": "closed", "state_reason": "not_planned" }
    },
    {
      "match": "/repos/acme/widgets/issues/7",
      "method": "PATCH",
      "json": { "number": 7, "state": "closed", "state_reason": "completed" }
    }
  ],
  "expect": {
    "createdKey": "42",
    "createdUrlContains": "issues/42",
    "openIssue": "7",
    "doneIssue": "8",
    "closeIssue": "7"
  }
}
