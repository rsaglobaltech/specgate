{
  "name": "@rsaglobaltech/specgate",
  "version": "0.17.2",
  "description": "Specs as executable contracts — requirements, scenarios and traceability that CI enforces.",
  "license": "MIT",
  "type": "commonjs",
  "bin": {
    "specgate": "bin/specgate.js",
    "csda": "bin/specgate.js",
    "create-spec-driven-app": "bin/specgate.js"
  },
  "files": [
    "bin/",
    "dist/bin/",
    "dist/scripts/",
    "dist/packages/core/",
    "dist/packages/mcp-spec-driven/src/",
    "templates/",
    "examples/",
    "vendor/",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rsaglobaltech/specgate.git"
  },
  "homepage": "https://rsaglobaltech.github.io/specgate/",
  "bugs": {
    "url": "https://github.com/rsaglobaltech/specgate/issues"
  },
  "keywords": [
    "spec-driven-development",
    "sdd",
    "gherkin",
    "traceability",
    "ci-gate",
    "ai-agents",
    "cli",
    "requirements",
    "bdd",
    "mcp"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prebuild": "npm run clean",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test": "node --test dist/tests/cli.test.js",
    "test:unit": "node scripts/run-tests.cjs dist/tests/unit",
    "test:core-unit": "node scripts/run-tests.cjs dist/packages/core/test/unit",
    "test:vscode-unit": "node scripts/run-tests.cjs dist/packages/vscode-spec-driven/test/unit",
    "test:mcp-unit": "node scripts/run-tests.cjs dist/packages/mcp-spec-driven/test/unit",
    "test:registry-unit": "node scripts/run-tests.cjs dist/packages/pack-registry/test/unit",
    "test:lsp-unit": "node scripts/run-tests.cjs dist/packages/lsp-spec-driven/test/unit",
    "registry:build": "node dist/packages/pack-registry/src/build.js",
    "test:snapshot": "node scripts/run-tests.cjs dist/tests/snapshot",
    "mutation:pilot": "npm run build && node scripts/check-mutation-targets.mjs && stryker run stryker.config.mjs",
    "test:coverage": "c8 --config .c8rc.json node scripts/run-tests.cjs dist/tests/unit dist/packages/core/test/unit",
    "test:bdd": "cucumber-js",
    "test:all": "npm test && npm run test:coverage && npm run test:bdd && npm run test:core-unit && npm run test:vscode-unit && npm run test:mcp-unit && npm run test:registry-unit && npm run test:lsp-unit && npm run test:snapshot && npm run registry:build",
    "pack:dry-run": "npm pack --dry-run",
    "pack": "npm pack",
    "demo:video": "bash scripts/demo/build-video.sh",
    "demo:video:de": "bash scripts/demo/de/build-video.sh --real-agent",
    "smoke:help": "node bin/specgate.js --help",
    "smoke:init": "node bin/specgate.js init --config examples/project.config.example --out .smoke-tmp --no-git --force",
    "smoke:validate": "node bin/specgate.js validate .smoke-tmp/acme-energy-hub",
    "smoke:report": "node bin/specgate.js report --project-dir .smoke-tmp/acme-energy-hub --stdout",
    "smoke:expand": "node bin/specgate.js expand --pack-root tests/fixtures/domain-packs --pack parking-management/backend --project-dir /private/tmp/acme-energy-hub --var PROJECT_NAME='Acme Energy Hub' --var PROJECT_SLUG=acme-energy-hub --var DOMAIN='community energy' --dry-run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"bin/**/*.{ts,js}\" \"scripts/**/*.ts\" \"tests/**/*.ts\" \"packages/**/*.ts\" \"features/**/*.ts\"",
    "lint:fix": "eslint --fix \"bin/**/*.{ts,js}\" \"scripts/**/*.ts\" \"tests/**/*.ts\" \"packages/**/*.ts\" \"features/**/*.ts\"",
    "format": "prettier --write \"bin/**/*.{ts,js}\" \"scripts/**/*.ts\" \"tests/**/*.ts\" \"packages/**/*.ts\" \"features/**/*.ts\"",
    "format:check": "prettier --check \"bin/**/*.{ts,js}\" \"scripts/**/*.ts\" \"tests/**/*.ts\" \"packages/**/*.ts\" \"features/**/*.ts\"",
    "e2e": "node e2e/run.mjs",
    "e2e:coverage": "node e2e/run.mjs --coverage --list",
    "verify": "npm run typecheck && npm run lint && npm test && npm run pack:dry-run && npm run selfcheck",
    "selfcheck": "node bin/specgate.js validate .",
    "docs:agent-contract": "node dist/scripts/gen_agent_contract.js",
    "docs:agent-contract:check": "node dist/scripts/gen_agent_contract.js --check",
    "docs:terminal": "node dist/scripts/docs/record-terminal.js",
    "docs:terminal:check": "node dist/scripts/docs/record-terminal.js --check",
    "sbom": "npm sbom --sbom-format cyclonedx > sbom.cyclonedx.json",
    "licenses": "npm run sbom && node dist/scripts/license_check.js --sbom sbom.cyclonedx.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@cucumber/gherkin": "^42.0.0",
    "@eslint/js": "^9.39.4",
    "@stryker-mutator/core": "^10.0.0",
    "@types/cucumber": "^7.0.3",
    "@types/node": "^26.2.0",
    "@types/vscode": "^1.134.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "ajv": "^8.20.0",
    "c8": "^12.0.0",
    "eslint": "^10.8.1",
    "fast-check": "^4.8.0",
    "js-yaml": "^5.2.3",
    "marked": "^18.0.10",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
