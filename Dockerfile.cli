# Official CLI image — run Specgate without a local Node.js.
#
#   docker build -f Dockerfile.cli -t specgate .
#   docker run --rm -v "$PWD:/workspace" specgate validate . --strict-tdd
#   docker run --rm -v "$PWD:/workspace" specgate doctor
#
# Enterprise use: mirror this image into your internal registry and CI
# runners never need Node.js or npmjs.org access.

# ── Build stage: compile TypeScript and pack the npm tarball ──────────────────
# The tarball is plain JavaScript, the same on every platform: build it once,
# natively, instead of once per platform under emulation (arm64 under QEMU
# made a release's image build hang for 25 minutes).
FROM --platform=$BUILDPLATFORM node:22-alpine AS build
WORKDIR /src
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY tsconfig.json ./
COPY bin ./bin
COPY scripts ./scripts
COPY packages ./packages
COPY templates ./templates
COPY examples ./examples
COPY schemas ./schemas
COPY README.md ./
RUN mkdir -p /out && npm run build && npm pack --pack-destination /out

# ── Runtime stage: tarball install only, no dev dependencies ──────────────────
FROM node:22-alpine
RUN apk add --no-cache git
COPY --from=build /out/*.tgz /tmp/specgate.tgz
RUN npm install -g /tmp/specgate.tgz && rm /tmp/specgate.tgz
WORKDIR /workspace
ENTRYPOINT ["specgate"]
CMD ["--help"]
