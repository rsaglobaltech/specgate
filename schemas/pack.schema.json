{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-driven.dev/schemas/pack/v1.json",
  "title": "Domain Pack",
  "description": "Schema for specgate domain pack files (pack.yaml).",
  "type": "object",
  "required": [
    "schema_version",
    "metadata",
    "variables",
    "requirements",
    "outputs",
    "rules"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "SemVer version of the pack.yaml schema.",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "metadata": {
      "type": "object",
      "required": [
        "name",
        "version",
        "language",
        "project_type"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2}$"
        },
        "project_type": {
          "type": "string",
          "enum": [
            "backend",
            "frontend",
            "mobile",
            "contracts"
          ]
        },
        "tier": {
          "type": "string",
          "enum": [
            "proven",
            "starter"
          ],
          "description": "How much to trust the pack. `proven`: derived from a product that implemented and tested every requirement it ships. `starter`: a generic example of the format, to be rewritten. Absent means `starter`."
        },
        "provenance": {
          "type": "string",
          "minLength": 1,
          "description": "Where the pack's requirements come from and what proved them. Required in practice for a `proven` pack; `pack lint` refuses one without it."
        }
      }
    },
    "variables": {
      "type": "object",
      "required": [
        "required"
      ],
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[A-Z_]+$"
          }
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "priority",
          "description",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^REQ-\\d+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "string",
            "enum": [
              "Must",
              "Should",
              "Could",
              "Won't"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "$ref": "#/$defs/status"
          },
          "depends_on": {
            "description": "Requirements in this pack that must land before this one. Optional: a pack whose requirements are independent says nothing, and every pack written before this key stays valid. The harness stacks a dependent's branch on its predecessor's rather than on the run's base.",
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^REQ-[A-Za-z0-9.]+$"
            }
          }
        }
      }
    },
    "bounded_contexts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "type",
          "responsibility",
          "aggregates"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^BC-\\d+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "Core",
              "Supporting",
              "Generic"
            ]
          },
          "responsibility": {
            "type": "string",
            "minLength": 1
          },
          "aggregates": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "use_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "actor",
          "requirement"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^UC-\\d+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "actor": {
            "type": "string",
            "minLength": 1
          },
          "requirement": {
            "type": "string",
            "pattern": "^REQ-\\d+$"
          },
          "command": {
            "type": "string"
          },
          "query": {
            "type": "string"
          },
          "aggregate": {
            "type": "string",
            "minLength": 1
          },
          "emits": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scenarios": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^SCN-\\d+$"
            }
          },
          "status": {
            "$ref": "#/$defs/status"
          }
        }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^CMD-\\d+$"
          },
          "name": {
            "type": "string",
            "pattern": "^[A-Z][a-zA-Z]+Command$"
          },
          "use_case": {
            "type": "string",
            "pattern": "^UC-\\d+$"
          },
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "aggregates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AGG-\\d+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "bounded_context": {
            "type": "string",
            "minLength": 1
          },
          "context": {
            "type": "string",
            "minLength": 1
          },
          "responsibilities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "invariants": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "commands": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "events": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "value_objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "fields",
          "invariants"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^VO-\\d+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "invariants": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^EVT-\\d+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "aggregate": {
            "type": "string",
            "minLength": 1
          },
          "producer": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "domain",
              "integration"
            ]
          },
          "consumers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "payload": {
            "description": "A field per entry, as `payload: [fileId: string]` \u2014 every curated pack writes this string spelling (issue #116; five of the eleven wrote the object form before). A block sequence of mappings, reading as an object per entry, is also accepted for a community pack that already uses it; retiring it is a separate, larger decision than migrating the curated packs that used to.",
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              ]
            }
          }
        }
      }
    },
    "outputs": {
      "type": "object",
      "required": [
        "files"
      ],
      "additionalProperties": false,
      "properties": {
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "target",
              "template"
            ],
            "additionalProperties": false,
            "properties": {
              "target": {
                "type": "string",
                "minLength": 1
              },
              "template": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "business_rules": {
      "type": "array",
      "description": "Invariants the domain imposes, independent of any implementation. Distinct from `rules`, which configures how the pack renders.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^RUL-\\d+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "context": {
            "type": "string",
            "pattern": "^BC-\\d+$",
            "description": "The bounded context this rule belongs to."
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "rules": {
      "type": "object",
      "required": [
        "traceability"
      ],
      "additionalProperties": false,
      "properties": {
        "traceability": {
          "type": "object",
          "required": [
            "target",
            "include_existing_rows",
            "default_status"
          ],
          "additionalProperties": false,
          "properties": {
            "target": {
              "type": "string",
              "minLength": 1
            },
            "include_existing_rows": {
              "type": "boolean"
            },
            "default_status": {
              "$ref": "#/$defs/status"
            }
          }
        }
      },
      "description": "How the pack renders into a project. Not domain rules \u2014 those are `business_rules`."
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "requirement_id",
          "target",
          "template",
          "feature",
          "scenario",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^SCN-\\d+$"
          },
          "requirement_id": {
            "type": "string",
            "pattern": "^REQ-\\d+$"
          },
          "use_case": {
            "type": "string",
            "pattern": "^UC-\\d+$"
          },
          "seed": {
            "type": "boolean"
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "template": {
            "type": "string",
            "minLength": 1
          },
          "feature": {
            "type": "string",
            "minLength": 1
          },
          "scenario": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "aggregate": {
            "type": "string",
            "minLength": 1
          },
          "events": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "technical_artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "test_artifact": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "$ref": "#/$defs/status"
          }
        },
        "description": "A scenario the pack seeds. The required fields are what the installer needs in order to render the feature file and write its traceability row. The domain-linkage fields (use_case, command, aggregate, events) are optional so a pack for a domain without CQRS is not forced to invent one \u2014 but they are validated when present."
      }
    },
    "api_contracts": {
      "type": "array",
      "description": "REST/GraphQL/event API contracts (contracts project_type only).",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "type",
          "provider",
          "consumers",
          "schema_ref"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AC-\\d+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "REST",
              "GraphQL",
              "AsyncAPI",
              "gRPC"
            ]
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "consumers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "schema_ref": {
            "type": "string",
            "minLength": 1
          },
          "requirement": {
            "type": "string",
            "pattern": "^REQ-\\d+$"
          }
        }
      }
    },
    "consumer_driven_tests": {
      "type": "array",
      "description": "Pact / consumer-driven contract test definitions (contracts project_type only).",
      "items": {
        "type": "object",
        "required": [
          "id",
          "consumer",
          "provider",
          "pact_file",
          "requirement"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^CDT-\\d+$"
          },
          "consumer": {
            "type": "string",
            "minLength": 1
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "pact_file": {
            "type": "string",
            "minLength": 1
          },
          "requirement": {
            "type": "string",
            "pattern": "^REQ-\\d+$"
          }
        }
      }
    },
    "breaking_change_rules": {
      "type": "array",
      "description": "Rules that define what constitutes a breaking change for each API contract.",
      "items": {
        "type": "object",
        "required": [
          "contract_id",
          "rules"
        ],
        "additionalProperties": false,
        "properties": {
          "contract_id": {
            "type": "string",
            "pattern": "^AC-\\d+$"
          },
          "requirement": {
            "type": "string",
            "pattern": "^REQ-\\d+$"
          },
          "rules": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "if": {
    "properties": {
      "metadata": {
        "properties": {
          "project_type": {
            "enum": [
              "backend",
              "frontend"
            ]
          }
        }
      }
    }
  },
  "then": {
    "required": [
      "bounded_contexts",
      "use_cases",
      "commands",
      "aggregates",
      "events",
      "scenarios"
    ]
  },
  "else": {
    "required": [
      "api_contracts"
    ]
  },
  "$defs": {
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Needs Clarification",
        "Domain Reviewed",
        "Architecture Reviewed",
        "Ready for Dev",
        "In Dev",
        "In Review",
        "Verified",
        "Released",
        "Deprecated"
      ]
    }
  }
}
