# Generated by `specgate ci init --provider github` (specgate {{SPECGATE_VERSION}}).
#
# The spec gate: no pull request merges if a requirement loses its feature
# file, its test or its traceability row, if the project's tests fail, or if a
# rule of its architecture breaks. It checks as much as specgate can; every
# step below says what it checks and what to delete to remove it. A step whose
# tool is not configured yet says so and passes.
#
# What this gate checks and lacks: `specgate ci status`.
# A one-step gate instead: `specgate ci init --provider github --minimal --force`.
name: Spec gate

on:
  pull_request:
  push:
    branches: [main]

jobs:
  spec-gate:
    # The gate on Ubuntu, macOS and Windows: paths, line endings and shells
    # differ, and a project that works on one can fail on another.
    # Remove: delete `macos-latest` and `windows-latest` to keep Ubuntu only.
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest, macos-latest, windows-latest]
    runs-on: ${{ matrix.os }}
    defaults:
      run:
        shell: bash
    steps:
      # The repository with its whole history, so the requirement ids can be
      # compared with the base branch (two branches never reuse one).
      # Remove `fetch-depth: 0` only together with `--base` below.
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
{{SETUP_STEPS}}
      # The gate: the specification (validate --strict), the links from each
      # requirement to its feature and test, the architecture check (arch_cmd)
      # and the project's tests (test_cmd), as `specgate check` runs them
      # locally; requirement ids compared with the base branch.
      # A test or architecture command not configured yet is said, with the
      # `specgate config set` that configures it, and does not fail.
      # Remove: never — this is the gate. Drop `--base …` to skip the id check.
      - name: The gate — specification, links, architecture, tests
        run: |
          {{GATE_CMD}} --base origin/${{ github.base_ref || github.event.repository.default_branch }}
      # The quality and security checks of harness.config.yaml (coverage,
      # mutation, dependencies, secrets — `specgate quality list`). They run in
      # Docker, so on Ubuntu only. Not configured yet: says how, and passes.
      # Remove: delete this step.
      - name: Quality checks
        if: matrix.os == 'ubuntu-latest'
        run: |
          if grep -q '^quality:' harness.config.yaml 2>/dev/null; then
            npx @rsaglobaltech/specgate@{{SPECGATE_VERSION}} quality run --stage ci --base origin/${{ github.base_ref || github.event.repository.default_branch }}
          else
            echo "Quality checks not configured — run: specgate quality init"
          fi
      # Supply-chain gate: fails when the rendered pack content no longer
      # matches the digest pinned in .specops.lock — a moved tag, a rewritten
      # history, or a hand-edited generated file. Skipped when the project
      # installs no packs. Packs in a private repository: add a SPECOPS_TOKEN
      # secret with read access to it.
      # Remove: delete this step.
      - name: Check pack drift
        env:
          SPECOPS_TOKEN: ${{ secrets.SPECOPS_TOKEN }}
        run: |
          if [ -n "$SPECOPS_TOKEN" ]; then
            git config --global url."https://x-access-token:${SPECOPS_TOKEN}@github.com/".insteadOf "https://github.com/"
          fi
          if [ -f .specops.lock ]; then
            npx @rsaglobaltech/specgate@{{SPECGATE_VERSION}} validate . --against-lock
          else
            echo "No .specops.lock — no packs installed, nothing to check."
          fi
      # What is left to build, requirement by requirement, as an artifact of
      # the run (`spec-plan`), from Ubuntu.
      # Remove: delete this step and the next.
      - name: Export pending-work plan
        if: always() && matrix.os == 'ubuntu-latest'
        run: npx @rsaglobaltech/specgate@{{SPECGATE_VERSION}} plan --project-dir . --format json > spec-plan.json
      # The plan above, kept with the run.
      # Remove: delete this step and the one above.
      - name: Upload plan artifact
        if: always() && matrix.os == 'ubuntu-latest'
        uses: actions/upload-artifact@v4
        with:
          name: spec-plan
          path: spec-plan.json
